{
  "name": "@desselbane/configs",
  "version": "17.1.2",
  "description": "This package contains the opinionated configuration files of Dessel Bane.",
  "type": "module",
  "files": [
    "dist/**",
    "vitest-shims.d.ts",
    "tsconfig.*.tpl.json",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DesselBane/mono",
    "directory": "packages/configs"
  },
  "engines": {
    "node": ">= 18"
  },
  "exports": {
    "./eslint": {
      "import": {
        "types": "./dist/eslint.config.tpl.d.ts",
        "default": "./dist/eslint.config.tpl.js"
      }
    },
    "./prettier": {
      "import": {
        "types": "./dist/prettier.config.tpl.d.ts",
        "default": "./dist/prettier.config.tpl.js"
      }
    },
    "./tsdown": {
      "import": {
        "types": "./dist/tsdown.config.tpl.d.ts",
        "default": "./dist/tsdown.config.tpl.js"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.config.tpl.d.ts",
        "default": "./dist/vitest.config.tpl.js"
      }
    },
    "./vitest.setup.js": {
      "import": {
        "types": "./dist/vitest.setup.d.ts",
        "default": "./dist/vitest.setup.js"
      }
    },
    "./vitest-serializer.setup.js": {
      "import": {
        "types": "./dist/vitest-serializer.setup.d.ts",
        "default": "./dist/vitest-serializer.setup.js"
      }
    },
    "./tsconfig.*.tpl.json": "./tsconfig.*.tpl.json",
    "./vitest-shims.d.ts": "./vitest-shims.d.ts"
  },
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "meta-updater": "node node/meta-updater.ts"
  },
  "volta": {
    "node": "24.20.0",
    "pnpm": "11.25.0"
  },
  "lint-staged": {
    "*": "eslint --fix --max-warnings 0"
  },
  "dependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/config-helpers": "0.7.0",
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unicorn": "74.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.10.0",
    "jest-extended": "7.0.0",
    "jiti": "2.7.0",
    "typescript-eslint": "8.69.0",
    "vue-eslint-parser": "10.4.1",
    "vue3-snapshot-serializer": "2.13.4",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@vue/test-utils": "^2.0.0",
    "tsdown": "^0.21.0 || ^0.22.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "@vue/test-utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vue/test-utils": "2.5.0",
    "prettier": "3.9.6",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "author": "Dessel Bane",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0"
    }
  }
}
