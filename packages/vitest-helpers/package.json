{
  "name": "@desselbane/vitest-helpers",
  "version": "1.0.6",
  "type": "module",
  "description": "Utilities to write better unit tests",
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DesselBane/mono",
    "directory": "packages/vitest-helpers"
  },
  "exports": {
    "./node/child_process": "./dist/node/child_process.js",
    "./node/fs": "./dist/node/fs.js",
    "./package.json": "./package.json",
    ".": "./dist/main.js"
  },
  "files": [
    "dist/**",
    "package.json",
    "CHANGELOG.md"
  ],
  "volta": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "lint-staged": {
    "*": "eslint --fix --max-warnings 0"
  },
  "peerDependencies": {
    "vitest": "^3.2.0 || ^4.0.0"
  },
  "devDependencies": {
    "@desselbane/configs": "workspace:*",
    "@types/node": "24.13.3",
    "tsdown": "0.22.14",
    "type-fest": "5.8.0",
    "typescript": "6.0.3",
    "unplugin-unused": "0.6.0",
    "vitest": "4.1.10"
  },
  "author": "Dessel Bane",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0"
    }
  }
}
