{
  "name": "@desselbane/ts-helpers",
  "version": "5.0.3",
  "type": "module",
  "description": "Helper package which includes typescript assertions and type guards",
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --build"
  },
  "files": [
    "dist/**",
    "package.json",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/main.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DesselBane/mono",
    "directory": "packages/ts-helpers"
  },
  "volta": {
    "node": "24.20.0",
    "pnpm": "12.3.4"
  },
  "lint-staged": {
    "*": "eslint --fix --max-warnings 0"
  },
  "dependencies": {
    "type-fest": "5.9.0"
  },
  "devDependencies": {
    "@desselbane/configs": "workspace:*",
    "@desselbane/vitest-helpers": "workspace:*",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "unplugin-unused": "0.6.0",
    "vitest": "4.1.11"
  },
  "types": "./dist/main.d.ts",
  "author": "Dessel Bane",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0"
    }
  }
}
